{
    "openapi": "3.0.3",
    "info": {
        "title": "Crack GRE Vocab API",
        "version": "0.1.0",
        "description": "Local API contract for the Milestone 1 cold rebuild."
    },
    "paths": {
        "/api/": {
            "get": {
                "operationId": "service_index_retrieve",
                "description": "Return the stable, non-readiness service document.",
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ServiceIndex"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/auth/account/": {
            "get": {
                "operationId": "auth_account_retrieve",
                "description": "Return the learner represented by the current server session.",
                "tags": [
                    "auth"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LearnerAccount"
                                }
                            }
                        },
                        "description": ""
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/auth/csrf/": {
            "get": {
                "operationId": "auth_csrf_retrieve",
                "description": "Issue the masked token required by session-backed mutations.",
                "tags": [
                    "auth"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    },
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CsrfToken"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/auth/sign-in/": {
            "post": {
                "operationId": "auth_sign_in_create",
                "description": "Create a Django session from an email and password.",
                "parameters": [
                    {
                        "in": "header",
                        "name": "X-CSRFToken",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Masked token from GET /api/auth/csrf/.",
                        "required": true
                    }
                ],
                "tags": [
                    "auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SignInRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    },
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LearnerAccount"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthValidationError"
                                }
                            }
                        },
                        "description": ""
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        },
                        "description": ""
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        },
                        "description": ""
                    },
                    "415": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/auth/sign-out/": {
            "post": {
                "operationId": "auth_sign_out_create",
                "description": "End the current session without exposing whether it existed.",
                "parameters": [
                    {
                        "in": "header",
                        "name": "X-CSRFToken",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Masked token from GET /api/auth/csrf/.",
                        "required": true
                    }
                ],
                "tags": [
                    "auth"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    },
                    {}
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/auth/sign-up/": {
            "post": {
                "operationId": "auth_sign_up_create",
                "description": "Create and immediately sign in a new learner.",
                "parameters": [
                    {
                        "in": "header",
                        "name": "X-CSRFToken",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Masked token from GET /api/auth/csrf/.",
                        "required": true
                    }
                ],
                "tags": [
                    "auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SignUpRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    },
                    {}
                ],
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LearnerAccount"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthValidationError"
                                }
                            }
                        },
                        "description": ""
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        },
                        "description": ""
                    },
                    "415": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/readiness/": {
            "get": {
                "operationId": "readiness_retrieve",
                "description": "Check the database without exposing connection failure details.",
                "tags": [
                    "readiness"
                ],
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Readiness"
                                }
                            }
                        },
                        "description": ""
                    },
                    "503": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Readiness"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/study/sessions/": {
            "post": {
                "operationId": "study_session_create",
                "tags": [
                    "study"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateStudySessionRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StudySession"
                                }
                            }
                        },
                        "description": ""
                    },
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StudySession"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StudyValidationError"
                                }
                            }
                        },
                        "description": ""
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StudyPlanningError"
                                }
                            }
                        },
                        "description": ""
                    },
                    "409": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StudyPlanningError"
                                }
                            }
                        },
                        "description": ""
                    },
                    "415": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StudyPlanningError"
                                }
                            }
                        },
                        "description": ""
                    },
                    "503": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StudyPlanningError"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/study/sessions/active/": {
            "get": {
                "operationId": "study_session_active_retrieve",
                "tags": [
                    "study"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StudySession"
                                }
                            }
                        },
                        "description": ""
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StudyPlanningError"
                                }
                            }
                        },
                        "description": ""
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StudyPlanningError"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ApiError": {
                "type": "object",
                "description": "Describe a non-field API error.",
                "properties": {
                    "detail": {
                        "type": "string"
                    }
                },
                "required": [
                    "detail"
                ]
            },
            "AuthValidationError": {
                "type": "object",
                "description": "Describe malformed JSON or field-level account input errors.",
                "properties": {
                    "detail": {
                        "type": "string"
                    },
                    "email": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "display_name": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "password": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "non_field_errors": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "CreateStudySessionRequest": {
                "type": "object",
                "properties": {
                    "new_word_target": {
                        "type": "integer",
                        "maximum": 20,
                        "minimum": 0
                    }
                },
                "required": [
                    "new_word_target"
                ]
            },
            "CsrfToken": {
                "type": "object",
                "description": "Return a masked CSRF token for one unsafe request.",
                "properties": {
                    "csrf_token": {
                        "type": "string"
                    }
                },
                "required": [
                    "csrf_token"
                ]
            },
            "DatabaseEnum": {
                "enum": [
                    "available",
                    "unavailable"
                ],
                "type": "string",
                "description": "* `available` - available\n* `unavailable` - unavailable"
            },
            "KindEnum": {
                "enum": [
                    "due",
                    "new"
                ],
                "type": "string",
                "description": "* `due` - Due review\n* `new` - New Word"
            },
            "LearnerAccount": {
                "type": "object",
                "description": "Return the public portion of the current learner account.",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "readOnly": true,
                        "title": "Email address"
                    },
                    "display_name": {
                        "type": "string",
                        "readOnly": true
                    }
                },
                "required": [
                    "display_name",
                    "email",
                    "id"
                ]
            },
            "Readiness": {
                "type": "object",
                "description": "Describe the stable ready or database-unavailable response shape.",
                "properties": {
                    "status": {
                        "$ref": "#/components/schemas/ReadinessStatusEnum"
                    },
                    "database": {
                        "$ref": "#/components/schemas/DatabaseEnum"
                    }
                },
                "required": [
                    "database",
                    "status"
                ]
            },
            "ReadinessStatusEnum": {
                "enum": [
                    "ready",
                    "unavailable"
                ],
                "type": "string",
                "description": "* `ready` - ready\n* `unavailable` - unavailable"
            },
            "ServiceIndex": {
                "type": "object",
                "description": "Describe the database-independent service document.",
                "properties": {
                    "service": {
                        "type": "string"
                    }
                },
                "required": [
                    "service"
                ]
            },
            "SignInRequest": {
                "type": "object",
                "description": "Validate the credentials supplied for a new server session.",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "minLength": 1,
                        "maxLength": 254
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    }
                },
                "required": [
                    "email",
                    "password"
                ]
            },
            "SignUpRequest": {
                "type": "object",
                "description": "Validate and create a clean-rebuild learner account.",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "minLength": 1,
                        "maxLength": 254
                    },
                    "display_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    }
                },
                "required": [
                    "display_name",
                    "email",
                    "password"
                ]
            },
            "StudyPlanningError": {
                "type": "object",
                "properties": {
                    "detail": {
                        "type": "string"
                    }
                },
                "required": [
                    "detail"
                ]
            },
            "StudySense": {
                "type": "object",
                "properties": {
                    "position": {
                        "type": "integer",
                        "maximum": 32767,
                        "minimum": 0
                    },
                    "part_of_speech": {
                        "type": "string",
                        "maxLength": 32
                    },
                    "definition": {
                        "type": "string"
                    },
                    "example": {
                        "type": "string"
                    }
                },
                "required": [
                    "definition",
                    "example",
                    "position"
                ]
            },
            "StudySession": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "status": {
                        "$ref": "#/components/schemas/StudySessionStatusEnum"
                    },
                    "corpus_version": {
                        "type": "string",
                        "readOnly": true
                    },
                    "new_word_target": {
                        "type": "integer",
                        "maximum": 32767,
                        "minimum": 0
                    },
                    "planned_new_word_count": {
                        "type": "integer",
                        "maximum": 32767,
                        "minimum": 0
                    },
                    "item_count": {
                        "type": "integer",
                        "maximum": 32767,
                        "minimum": 0
                    },
                    "planner_version": {
                        "type": "string",
                        "maxLength": 64
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/StudySessionItem"
                        },
                        "readOnly": true
                    }
                },
                "required": [
                    "corpus_version",
                    "created_at",
                    "id",
                    "item_count",
                    "items",
                    "new_word_target",
                    "planned_new_word_count",
                    "planner_version",
                    "status"
                ]
            },
            "StudySessionItem": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "position": {
                        "type": "integer",
                        "maximum": 32767,
                        "minimum": 0
                    },
                    "kind": {
                        "$ref": "#/components/schemas/KindEnum"
                    },
                    "word_id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "term": {
                        "type": "string",
                        "readOnly": true
                    },
                    "pronunciation": {
                        "type": "string",
                        "readOnly": true
                    },
                    "senses": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/StudySense"
                        },
                        "readOnly": true
                    }
                },
                "required": [
                    "id",
                    "kind",
                    "position",
                    "pronunciation",
                    "senses",
                    "term",
                    "word_id"
                ]
            },
            "StudySessionStatusEnum": {
                "enum": [
                    "active",
                    "completed",
                    "abandoned"
                ],
                "type": "string",
                "description": "* `active` - Active\n* `completed` - Completed\n* `abandoned` - Abandoned"
            },
            "StudyValidationError": {
                "type": "object",
                "properties": {
                    "detail": {
                        "type": "string"
                    },
                    "new_word_target": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "sessionid"
            }
        }
    }
}