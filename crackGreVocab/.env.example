# Local development only. Production values belong in the hosting provider's
# secret store and must not be committed.
SECRET_KEY=replace-with-a-long-random-development-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql:///crack_gre_vocab
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000/reset-password/confirm
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Crack GRE Vocab <no-reply@localhost>
SECURE_SSL_REDIRECT=false
# Enable only when every request reaches Django through a trusted proxy that
# replaces (rather than appends to) X-Forwarded-Proto.
TRUST_X_FORWARDED_PROTO=false
# Enable only after confirming every subdomain is HTTPS-only.
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
